{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arxell Speak",
  "version": "0.1.2-rc.4",
  "identifier": "dev.arxell.speak",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Arxell Speak — 0.1.2-rc.4 X11 TEST",
        "width": 720,
        "height": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "macOS": { "infoPlist": "Info.plist" },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
